{
	// This file is not used in compilation. It is here just for a nice editor experience.
	// The options are inlined from `@docusaurus/tsconfig` (without `baseUrl`)
	// because it sets the `baseUrl` option, which was removed in TypeScript 7.
	"compilerOptions": {
		"allowJs": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"moduleResolution": "bundler",
		"module": "esnext",
		"noEmit": true,
		"paths": {
			"@site/*": ["./*"],
			"*": ["./*"]
		},
		"skipLibCheck": true
	},
	"exclude": [".docusaurus", "build"]
}
